(: lcg-rule (-> Atom))
(= (lcg-rule)
   (: LCG ;; Least Common Generalization
      (-> (≞ $c1 $c1tv)
          (≞ $c2 $c2tv)
          (≞ $lcg $lcgtv)
          (≞ (→ $c1 $lcg ()) $c1lcgtv)
          (≞ (→ $c2 $lcg ()) $c2lcgtv)
          (≞ (→ $c1 $c2 ($lcg)) (Method lcg-formula $c1tv $c2tv $lcgtv $c1lcgtv $c2lcgtv)))))

(: single-depth-lcg-rule (-> Atom))
(= (single-depth-lcg-rule)
    (superpose(
        (lcg-rule)
        (: FDFCLR
            (-> (≞ $c1 $c1tv)
                (≞ $c2 $c2tv)
                (≞ $lcg $lcgtv)
                (≞ (→ $c1 $var ()) $c1vartv)
                (≞ (→ $var $lcg ()) $varlcgtv)
                (≞ (→ $c2 $lcg ()) $c2lcgtv)
                (≞ (→ $c1 $c2 ($lcg)) (Method lcg-formula $c1tv $c2tv $lcgtv (STV ($c1vartv $varlcgtv) ()) $c2lcgtv)))
        )
        (: FDSCLR
            (-> (≞ $c1 $c1tv)
                (≞ $c2 $c2tv)
                (≞ $lcg $lcgtv)
                (≞ (→ $c1 $lcg ()) $c1lcgtv)
                (≞ (→ $c2 $var ()) $c2vartv)
                (≞ (→ $var $lcg ()) $varlcgtv)
                (≞ (→ $c1 $c2 ($lcg)) (Method lcg-formula $c1tv $c2tv $lcgtv $c1lcgtv (STV ($c2vartv $varlcgtv) ()))))
        )
        )
    )
)

(: double-depth-lcg-rule)
(= (double-depth-lcg-rule)
    (superpose(
        (single-depth-lcg-rule)
        (: DDFCLR
            (-> (≞ $c1 $c1tv)
                (≞ $c2 $c2tv)
                (≞ $lcg $lcgtv)
                (≞ (→ $c1 $var ()) $c1vartv)
                (≞ (→ $var $var1 ()) $varvar1tv)
                (≞ (→ $var1 $lcg ()) $var1lcgtv)
                (≞ (→ $c2 $lcg ()) $c2lcgtv)
                (≞ (→ $c1 $c2 ($lcg)) (Method lcg-formula $c1tv $c2tv $lcgtv (STV ($c1vartv $varvar1tv $var1lcgtv) ()) $c2lcgtv)))
        )
        (: DDSCLR
            (-> (≞ $c1 $c1tv)
                (≞ $c2 $c2tv)
                (≞ $lcg $lcgtv)
                (≞ (→ $c1 $lcg ()) $c1lcgtv)
                (≞ (→ $c2 $var ()) $c2vartv)
                (≞ (→ $var $var1 ()) $varvar1tv)
                (≞ (→ $var1 $lcg ()) $var1lcgtv)
                (≞ (→ $c1 $c2 ($lcg)) (Method lcg-formula $c1tv $c2tv $lcgtv $c1lcgtv (STV ($c2vartv $varvar1tv $var1lcgtv) ()))))
        )
        )
    )
)

(= (concept-hierarchy)
    (: $proof (≞ ))
)
