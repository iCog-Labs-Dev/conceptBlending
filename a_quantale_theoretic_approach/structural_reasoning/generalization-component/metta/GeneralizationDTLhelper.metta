; ; !(list-avg (stv ((stv 2 3) (stv 3 4) (stv 2 3)) ))
; !(list-average (stv 0.88 0.84) (stv 0.9 0.86))
(= (lcg-formula (stv $sc1 $cc1)
                    (stv $sc2 $cc2)
                    (stv $slcg $clcg)
                    (stv $sc1lcg $cc1lcg)
                    (stv $sc2lcg $cc2lcg))
   (if (and (== (get-metatype $sc1lcg) Expression) (== (get-metatype $sc2lcg) Grounded))
        (let (stv $sc1lcgf $cc1lcgf) (list-average $sc1lcg)
            (stv (+ (/safe (* (* $sc1lcgf $sc2lcg) $slcg)
                        $sc2)
                (/safe (* $slcg (* (- 1 $sc1lcgf) (- 1 $sc2lcg)))
                        (- 1 $sc2)))
                (Truth_w2c (min $cc1lcgf $cc2lcg))
            )
        )
        (if (and (== (get-metatype $sc2lcg) Expression) (== (get-metatype $sc1lcg) Grounded))
            (let (stv $sc2lcgf $cc2lcgf) (list-average $sc2lcg)
                (stv (+ (/safe (* (* $sc1lcg $sc2lcgf) $slcg)
                        $sc2)
                    (/safe (* $slcg (* (- 1 $sc1lcg) (- 1 $sc2lcgf)))
                            (- 1 $sc2)))
                    (Truth_w2c (min $cc1lcg $cc2lcgf))
                )
            )
            (if (and (== (get-metatype $sc2lcg) Expression) (== (get-metatype $sc1lcg) Expression))
                (let ((stv $sc1lcgf $cc1lcgf) (stv $sc2lcgf $cc2lcgf)) (collapse(superpose((eval (list-average $sc1lcg)) (eval (list-average $sc2lcg)))))
                    (stv (+ (/safe (* (* $sc1lcgf $sc2lcgf) $slcg)
                        $sc2)
                        (/safe (* $slcg (* (- 1 $sc1lcgf) (- 1 $sc2lcgf)))
                            (- 1 $sc2)))
                        (Truth_w2c (min $cc1lcgf $cc2lcgf))
                    )
                )
                (stv (+ (/safe (* (* $sc1lcg $sc2lcg) $slcg)
                    $sc2)
                    (/safe (* $slcg (* (- 1 $sc1lcg) (- 1 $sc2lcg)))
                        (- 1 $sc2)))
                    (Truth_w2c (min $cc1lcg $cc2lcg))
                )
            )
        )
    ))
